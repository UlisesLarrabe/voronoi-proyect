        sticky: true,
      });
    },
  }).addTo(map);

  const voronoiLayer = L.geoJSON(null, {
    style: (feature) => ({
      fillColor: feature?.properties.color,
      fillOpacity: 0.2,
      color: "#2563eb",
      weight: 1.5,
    }),
    onEachFeature: (feature, layer) => {
      layer.bindTooltip(`<b>${feature.properties.nombre}</b>`, {
        sticky: true,
      });
    },
  });

  const markersLayer = L.layerGroup().addTo(map);

  const limiteLayer = L.geoJSON(laMatanzaFeature, {
    style: { color: "#dc2626", weight: 2.5, dashArray: "5, 5", fillOpacity: 0 },
  }).addTo(map);

  L.control
    .layers(
      undefined,
      {
        "🔵 Voronoi recortado": voronoiLayerWithLimits,
        "⬜ Voronoi rectangular": voronoiLayer,
        "👮 Comisarías": markersLayer,
        "🗺️ Límite municipal": limiteLayer,
      },
      { collapsed: false },
    )
    .addTo(map);

  function actualizarMapa(lista: typeof comisariasOriginales) {
    const geoPoints = turf.featureCollection(
      lista.map((c) =>
        turf.point([c.lng, c.lat], { nombre: c.nombre, dir: c.dir }),
      ),
    );

    const rawVoronoi = turf.voronoi(geoPoints, { bbox: bboxLaMatanza as any });

    const celdasBase: any[] = [];
    const celdasRecortadas: any[] = [];

    rawVoronoi.features.forEach((celda, i) => {
      if (!celda) return;
      const color = colours[i % colours.length];
      const props = { ...lista[i], color };

      const celdaRaw = structuredClone(celda);
      celdaRaw.properties = props;
      celdasBase.push(celdaRaw);

      let inter = null;
      try {
        inter = turf.intersect(
          turf.featureCollection([celda, laMatanzaFeature]),
        );
      } catch {
        inter = (turf as any).intersect(celda, laMatanzaFeature);
      }

      if (inter) {
        inter.properties = props;
        celdasRecortadas.push(inter);
      }
    });

    voronoiLayer.clearLayers();
    voronoiLayerWithLimits.clearLayers();
    markersLayer.clearLayers();

    voronoiLayer.addData(turf.featureCollection(celdasBase) as any);
    voronoiLayerWithLimits.addData(
      turf.featureCollection(celdasRecortadas) as any,
    );

    lista.forEach((c) => {
      L.marker([c.lat, c.lng])
        .bindPopup(`<b>👮 ${c.nombre}</b><br>📍 ${c.dir}`)
        .addTo(markersLayer);
    });
  }

  actualizarMapa(comisariasOriginales);
  map.fitBounds(limiteLayer.getBounds());

  let isRecomendado = false;
  const btn = document.getElementById("toggle-btn");

  btn?.addEventListener("click", () => {
    isRecomendado = !isRecomendado;

    if (isRecomendado) {
      actualizarMapa(comisariasRecomendadas);
      btn.textContent = "Mostrar original";
    } else {
      actualizarMapa(comisariasOriginales);
      btn.textContent = "Mostrar recomendado";
    }
  });

  requestAnimationFrame(() => {
    map.invalidateSize();
  });
</script>
