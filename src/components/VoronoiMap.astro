  const laMatanzaFeature =
    (laMatanzaData.features as any[]).find(
      (f) =>
        f.geometry.type === "Polygon" || f.geometry.type === "MultiPolygon",
    ) || laMatanzaData.features[0];

  const bboxLaMatanza = turf.bbox(laMatanzaFeature);
  const colours = [
    "#3b82f6",
    "#10b981",
    "#f59e0b",
    "#ef4444",
    "#8b5cf6",
    "#ec4899",
    "#06b6d4",
    "#84cc16",
    "#14b8a6",
    "#6366f1",
  ];

  const map = L.map("map").setView([-34.75, -58.62], 11);

  L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
    maxZoom: 19,
    attribution:
      '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
  }).addTo(map);

  const voronoiLayerWithLimits = L.geoJSON(null, {
    style: (feature) => ({
      fillColor: feature?.properties.color,
      fillOpacity: 0.35,
      color: "#1e293b",
      weight: 1.5,
    }),
    onEachFeature: (feature, layer) => {
